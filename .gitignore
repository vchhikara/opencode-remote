# Dotfolders — local/machine-specific state, not source.
# .git and .github are the only dotfolders that should ever be tracked.
# .docs/ (here and under android-application/) holds internal working
# notes/plans and is intentionally local-only, like every other dotfolder.
.*/
!.github/

*.iml
/local.properties
.DS_Store
/build
/captures
local.properties
.env
debug.keystore

# Node servers inside repo
node_modules/
bridge/node_modules/

# Secrets / keystores
*.keystore
*.jks
google-services.json

# Python
__pycache__/
*.pyc

# Gradle build outputs (any module)
**/build/

# Stray Windows binary + local runtime data
cmd.exe
token-optimizer/

# Bridge runtime state (session persistence, audit log, device tokens) -
# generated at runtime by bridge/main.js, not source
bridge/.opencode-remote-session.json
bridge/.opencode-remote-audit.log
bridge/.opencode-remote-devices.json
bridge/.device-tokens.json
# Same runtime state, written under android-application/ when the bridge
# is run with that directory as its cwd (e.g. during manual device testing)
android-application/.opencode-remote-session.json

# Built debug/release APKs left at the repo root during manual install/testing
/*.apk

# Scratch content an opencode agent creates in a workspace during manual
# testing, and manual-verification screenshots (not project deliverables)
/welcome.md
/phase8_verify/

# Handoff/redesign working files (deliverables already merged into
# android-application/ source; these are source zips/transcripts, not
# project deliverables themselves)
*.zip
/OpenCode Remote - Redesign.dc.html
android-application/handoff-1.md
android-application/Claude_RT_app_transcript_reconstructed.md

# Notion sync canonical files (skill: notion-sync) - local source of truth,
# never committed to GitHub per explicit instruction
/spec.md
/progress.md
/ledger.md
/.notion_sync_state.json
