<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext (ws://, not wss://) is permitted globally by design: this
    app connects only to a user-configured bridge host/port (LAN IP,
    Tailscale address, or tunnel hostname — see README "Transport Security"),
    never to arbitrary internet hosts, and Android's Network Security Config
    has no way to scope cleartext permission to "any private/LAN IP" (no
    CIDR support, only exact-domain/IP or subdomain-suffix matching). Users
    wanting transport encryption should connect via Tailscale or a tunnel,
    as documented in the README, rather than relying on this config. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
